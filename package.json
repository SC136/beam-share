{
  "name": "beam-share",
  "version": "0.1.0",
  "description": "Terminal UI for sharing files peer-to-peer on your local network or, via a relay you host, over the internet. Run `npx beam-share` and send files.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SC136/beam-share.git"
  },
  "homepage": "https://github.com/SC136/beam-share#readme",
  "bugs": {
    "url": "https://github.com/SC136/beam-share/issues"
  },
  "type": "module",
  "bin": {
    "beam-share": "bin/beam.js",
    "beam": "bin/beam.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/beam.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lan",
    "p2p",
    "file-transfer",
    "file-sharing",
    "tui",
    "terminal",
    "local-network",
    "internet",
    "relay",
    "encrypted"
  ],
  "license": "MIT"
}
